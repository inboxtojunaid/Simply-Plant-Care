---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const guides = await getCollection("guides");

const categoryLabels: Record<string, string> = {
  beginner: "Beginner",
  watering: "Watering",
  lighting: "Lighting",
  "plant-care": "Plant Care",
  growing: "Growing & Potting",
};

const grouped: Record<string, typeof guides> = {};
for (const g of guides) {
  const cat = g.data.category;
  if (!grouped[cat]) grouped[cat] = [];
  grouped[cat].push(g);
}
const categoryOrder = ["beginner", "watering", "lighting", "plant-care", "growing"];
---

<BaseLayout
  title="All Plant Care Guides"
  description="Browse every Simply Plant Care guide — beginner care, watering, lighting, plant-specific care, and growing in pots."
  canonicalPath="/guides/"
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li aria-current="page">Guides</li>
    </ol>
  </nav>

  <h1>All guides</h1>
  <p class="prose">
    Every guide on Simply Plant Care, grouped by topic. Start with the
    beginner guides if you are new, or jump straight to the plant you own.
  </p>

  {
    guides.length === 0 ? (
      <p>Guides are being added — check back soon.</p>
    ) : (
      categoryOrder.map(
        (cat) =>
          grouped[cat] && (
            <section class="section" aria-labelledby={`cat-${cat}`}>
              <h2 id={`cat-${cat}`}>{categoryLabels[cat]}</h2>
              <div class="card-grid">
                {grouped[cat].map((g) => (
                  <article class="card">
                    <h3>
                      <a href={`/guides/${g.id.replace(/\.md$/, "")}/`}>{g.data.title}</a>
                    </h3>
                    <p>{g.data.description}</p>
                  </article>
                ))}
              </div>
            </section>
          ),
      )
    )
  }
</BaseLayout>
