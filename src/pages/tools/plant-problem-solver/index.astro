            score: (a) => 1,
            articles: [A("how-do-you-take-care-of-plants", "How Do You Take Care of Plants? Beginner Guide")],
          },
        ],
      },
      "soft-stems": {
        label: "Soft or mushy stems",
        intro: "Soft, mushy stems are the most urgent symptom here — they usually mean rot, and rot spreads.",
