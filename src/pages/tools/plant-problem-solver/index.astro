---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Plant Problem Solver"
  description="Answer a few questions about your plant's symptoms and get the most likely causes, what to check, and what to do next."
  canonicalPath="/tools/plant-problem-solver/"
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li aria-current="page">Plant Problem Solver</li>
    </ol>
  </nav>

  <h1>Plant Problem Solver</h1>
  <p class="prose">
    Pick the symptom that best matches your plant, answer a few quick
    questions, and we will suggest the most likely causes — plus what to
    inspect and what to do next.
  </p>

  <div class="disclaimer-box">
    <strong>Not a diagnosis.</strong> This tool suggests possibilities, not a
    diagnosis — several problems can cause similar symptoms. Use the results
    as a starting point for checking your plant, not as a definitive answer.
  </div>

  <div class="progress-wrap" aria-live="polite">
    <div class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="solver-progress">
      <div class="progress-fill" id="solver-progress-fill" style="width: 0%"></div>
    </div>
    <p class="progress-label" id="solver-step-label">Step 1 of 3 — Choose a symptom</p>
  </div>

  <!-- Step 1 -->
  <section class="tool-step active" id="step-1" aria-labelledby="step-1-heading">
    <h2 id="step-1-heading">What is happening to your plant?</h2>
    <div class="symptom-grid" id="symptom-grid" role="group" aria-label="Symptoms"></div>
  </section>

  <!-- Step 2 -->
  <section class="tool-step" id="step-2" aria-labelledby="step-2-heading">
    <h2 id="step-2-heading">A few quick questions</h2>
    <p id="step-2-intro"></p>
    <div id="questions"></div>
    <div class="tool-nav">
      <button type="button" class="btn btn-secondary" id="back-to-1">Back</button>
      <button type="button" class="btn" id="to-results">See possible causes</button>
    </div>
  </section>

  <!-- Step 3 -->
  <section class="tool-step" id="step-3" aria-labelledby="step-3-heading">
    <h2 id="step-3-heading">Most likely causes</h2>
    <p id="results-intro"></p>
    <div id="results"></div>
    <div class="tool-nav">
      <button type="button" class="btn btn-secondary" id="back-to-2">Back</button>
      <button type="button" class="btn" id="start-over">Start over</button>
    </div>
  </section>

  <script>
    type Answers = Record<string, string>;
    type Cause = {
      title: string;
      reasoning: string;
      inspect: string[];
      actions: string[];
      avoid: string;
      score: (a: Answers) => number;
      articles: { slug: string; title: string }[];
    };
    type Symptom = {
      label: string;
      intro: string;
      questions: string[];
      causes: Cause[];
    };

    const QUESTIONS: Record<string, { label: string; options: { value: string; label: string }[] }> = {
      soil: {
        label: "How does the soil feel about 5 cm (two inches) down?",
        options: [
          { value: "wet", label: "Wet or soggy" },
          { value: "damp", label: "Damp" },
          { value: "dry", label: "Dry" },
          { value: "unsure", label: "Not sure" },
        ],
      },
      drainage: {
        label: "Does the pot have drainage holes?",
        options: [
          { value: "yes", label: "Yes" },
          { value: "no", label: "No" },
          { value: "unsure", label: "Not sure" },
        ],
      },
      light: {
        label: "How much light does the plant get?",
        options: [
          { value: "direct", label: "Direct sun for several hours" },
          { value: "bright", label: "Bright, indirect light" },
          { value: "low", label: "Low light — far from a window" },
          { value: "unsure", label: "Not sure" },
        ],
      },
      leaves: {
        label: "Which leaves are affected?",
        options: [
          { value: "old", label: "Mostly older, lower leaves" },
          { value: "new", label: "Mostly new growth" },
          { value: "all", label: "All over the plant" },
          { value: "unsure", label: "Not sure" },
        ],
      },
      watering: {
        label: "How often do you water?",
        options: [
          { value: "often", label: "More than once a week" },
          { value: "weekly", label: "About once a week" },
          { value: "rarely", label: "Every 3 weeks or less" },
          { value: "unsure", label: "No fixed routine" },
        ],
      },
    };

    const A = (slug: string, title: string) => ({ slug, title });

    const SOLVER: Record<string, Symptom> = {
      "yellow-leaves": {
        label: "Yellow leaves",
        intro: "Yellow leaves are the most common complaint — and the most ambiguous. Your answers will narrow it down.",
        questions: ["soil", "drainage", "leaves", "watering"],
        causes: [
          {
            title: "Overwatering / root rot starting",
            reasoning: "Wet soil plus yellowing — especially on lower leaves — is the classic overwatering pattern. Roots sitting in water cannot take up oxygen, and the leaves yellow as they starve.",
            inspect: ["Check the soil two inches down — is it still wet days after watering?", "Smell the soil; a sour or rotten smell points to rot.", "Gently check whether the base of the stem feels soft."],
            actions: ["Stop watering and let the soil dry out before watering again.", "If the pot has no drainage holes, move the plant to one that does.", "Remove fully yellow leaves — they will not turn green again."],
            avoid: "Do not fertilise a plant that is already struggling — it adds stress, not help.",
            score: (a) => (a.soil === "wet" ? 3 : 0) + (a.drainage === "no" ? 2 : 0) + (a.watering === "often" ? 2 : 0) + (a.leaves === "old" ? 1 : 0),
            articles: [A("how-to-take-care-of-a-snake-plant", "How to Take Care of a Snake Plant"), A("how-to-water-snake-plants", "How to Water Snake Plants")],
          },
          {
            title: "Underwatering",
            reasoning: "Dry soil and yellowing leaves, often starting at the edges, point to the plant not getting enough water to support all its leaves.",
            inspect: ["Check whether the soil has pulled away from the sides of the pot.", "See if the pot feels unusually light when lifted."],
            actions: ["Water thoroughly until it runs out of the drainage holes.", "If the soil is bone dry and repels water, soak the pot in a bowl of water for 20–30 minutes."],
            avoid: "Do not water a little every day — shallow watering keeps the top wet and the roots dry.",
            score: (a) => (a.soil === "dry" ? 3 : 0) + (a.watering === "rarely" ? 2 : 0),
            articles: [A("how-do-you-take-care-of-plants", "How Do You Take Care of Plants? Beginner Guide")],
          },
          {
            title: "Natural ageing of old leaves",
            reasoning: "One or two lower leaves yellowing and dropping now and then is normal — the plant sheds old leaves as it grows. It is only a problem if many leaves yellow at once.",
            inspect: ["Count how many leaves are affected — one or two old ones is usually fine.", "Check that new growth looks healthy."],
            actions: ["Remove the yellow leaf at the base.", "Keep caring for the plant as normal."],
            avoid: "Do not change your watering routine over a single yellowing leaf.",
            score: (a) => (a.leaves === "old" ? 3 : 0) + (a.soil === "damp" ? 1 : 0),
            articles: [A("how-do-you-take-care-of-plants", "How Do You Take Care of Plants? Beginner Guide")],
          },
          {
            title: "Not enough light",
            reasoning: "In low light a plant cannot photosynthesise enough to support all its leaves, so it sheds the oldest ones first — they turn yellow, then drop.",
            inspect: ["Is the plant far from a window, or in a north-facing room?", "Is new growth pale, small, or stretched towards the light?"],
            actions: ["Move the plant closer to a bright window (out of harsh direct sun for most plants).", "Rotate it every week or two so all sides get light."],
            avoid: "Do not move a plant straight into full midday sun — it can scorch.",
            score: (a) => (a.light === "low" ? 3 : 0),
            articles: [A("plants-that-grow-in-the-dark", "Plants That Grow in the Dark (Low Light)"), A("snake-plant-light-needs", "Snake Plant Light Needs Explained")],
          },
        ],
      },
      "brown-tips": {
        label: "Brown leaf tips",
        intro: "Brown, crispy leaf tips usually point to water quality, low humidity, or inconsistent watering.",
        questions: ["soil", "watering", "leaves"],
        causes: [
          {
            title: "Low humidity or dry air",
            reasoning: "Thin-leaved plants like calathea, ferns, and spider plants crisp at the tips when the air is dry — common in heated rooms in winter.",
            inspect: ["Are the brown tips dry and papery, rather than soft?", "Is the plant near a radiator or heating vent?"],
            actions: ["Move the plant away from radiators and draughts.", "Group plants together to raise local humidity, or use a pebble tray under the pot."],
            avoid: "Misting alone rarely raises humidity for long — it is not a reliable fix on its own.",
            score: (a) => 2,
            articles: [A("how-to-care-for-calathea", "How to Care for Calathea"), A("how-do-you-care-for-ferns", "How Do You Care for Ferns Indoors?")],
          },
          {
            title: "Tap water salts and minerals",
            reasoning: "Fluoride and salts in tap water build up in leaf tips, which brown and crisp. Spider plants are famously sensitive to this.",
            inspect: ["Are the tips brown while the rest of the leaf is healthy?", "Is there a white crust on the soil surface or pot rim?"],
            actions: ["Try watering with rainwater, distilled water, or tap water left out overnight.", "Flush the soil occasionally by watering until plenty runs out of the bottom."],
            avoid: "Do not just trim the brown tips and carry on — the cause will keep browning new growth.",
            score: (a) => 2,
            articles: [A("how-do-you-take-care-of-a-spider-plant", "How Do You Take Care of a Spider Plant?"), A("how-to-care-for-calathea", "How to Care for Calathea")],
          },
          {
            title: "Inconsistent watering",
            reasoning: "Long dry spells followed by a big drink stress leaf tips first — they are the furthest point from the roots.",
            inspect: ["Does the soil swing between bone dry and soaking wet?", "Are the tips brown on new leaves too?"],
            actions: ["Water when the top few centimetres of soil are dry, and water evenly.", "Check soil moisture weekly rather than watering on a fixed day."],
            avoid: "Do not water a little every day — it keeps the surface wet and the roots dry.",
            score: (a) => (a.watering === "rarely" ? 2 : 0) + (a.soil === "dry" ? 1 : 0),
            articles: [A("how-do-you-take-care-of-plants", "How Do You Take Care of Plants? Beginner Guide")],
          },
        ],
      },
      drooping: {
        label: "Drooping leaves",
        intro: "Drooping can mean the plant is thirsty — or that its roots are too wet to drink. The soil check tells them apart.",
        questions: ["soil", "watering", "drainage"],
        causes: [
          {
            title: "Thirsty plant",
            reasoning: "Dry soil plus drooping leaves is straightforward: the plant has run out of water and cannot hold its leaves up.",
            inspect: ["Is the soil dry two inches down?", "Does the pot feel light?"],
            actions: ["Water thoroughly until it drains from the bottom.", "If the soil is very dry, soak the pot in water for 20–30 minutes."],
            avoid: "Do not water a little at a time — give it a proper soak.",
            score: (a) => (a.soil === "dry" ? 3 : 0) + (a.watering === "rarely" ? 2 : 0),
            articles: [A("how-do-you-take-care-of-plants", "How Do You Take Care of Plants? Beginner Guide")],
          },
          {
            title: "Overwatering / root damage",
            reasoning: "A drooping plant in wet soil is the confusing one: the roots are damaged and cannot take up water, so the plant looks thirsty while drowning.",
            inspect: ["Is the soil still wet days after watering?", "Does the soil smell sour?", "Are the stems soft at the base?"],
            actions: ["Stop watering and let the soil dry out.", "If the pot has no drainage, repot into one that does, trimming any black, mushy roots."],
            avoid: "Do not water a drooping plant without checking the soil first — more water makes this worse.",
            score: (a) => (a.soil === "wet" ? 3 : 0) + (a.drainage === "no" ? 2 : 0) + (a.watering === "often" ? 2 : 0),
            articles: [A("how-to-take-care-of-a-snake-plant", "How to Take Care of a Snake Plant"), A("how-to-water-snake-plants", "How to Water Snake Plants")],
          },
          {
            title: "Temperature shock or draught",
            reasoning: "A sudden cold draught, a move to a new spot, or heat from a radiator can make leaves droop within a day.",
            inspect: ["Is the plant near a door, an air conditioner, or a radiator?", "Did it recently move?"],
            actions: ["Move it to a spot with stable temperature, away from draughts and radiators.", "Give it a few days to recover before changing anything else."],
            avoid: "Do not repot or fertilise a plant that is just shocked — it needs stability, not more change.",
            score: (a) => 1,
            articles: [A("how-to-care-for-a-ficus-tree", "How to Care for a Ficus Tree")],
          },
        ],
      },
      "brown-spots": {
        label: "Brown spots",
        intro: "Brown spots on leaves can come from sun, water sitting on leaves, or a fungal or bacterial problem.",
        questions: ["light", "leaves", "soil"],
        causes: [
          {
            title: "Sun scorch",
            reasoning: "Direct sun through glass can burn leaves, leaving dry brown patches — usually on the side facing the window.",
            inspect: ["Are the spots on the sun-facing side?", "Are the patches dry and papery?"],
            actions: ["Move the plant back from the window or into bright, indirect light.", "Trim badly scorched leaves if you like — they will not heal."],
            avoid: "Do not move a plant from shade straight into full sun.",
            score: (a) => (a.light === "direct" ? 3 : 0),
            articles: [A("snake-plant-light-needs", "Snake Plant Light Needs Explained")],
          },
          {
            title: "Fungal or bacterial leaf spot",
            reasoning: "Spots with yellow halos that spread, especially in warm, damp conditions, often point to a fungal or bacterial infection.",
            inspect: ["Are the spots spreading or getting bigger?", "Do they have yellow rings around them?", "Are leaves staying wet for long periods?"],
            actions: ["Remove affected leaves and dispose of them (not in compost).", "Improve air circulation and avoid wetting the leaves when watering.", "Keep the plant isolated from other plants until it stabilises."],
            avoid: "Do not mist a plant with leaf spots — wet leaves help the problem spread.",
            score: (a) => (a.soil === "wet" ? 2 : 0) + (a.leaves === "all" ? 1 : 0),
            articles: [A("how-do-you-take-care-of-plants", "How Do You Take Care of Plants? Beginner Guide")],
          },
          {
            title: "Water damage on leaves",
            reasoning: "Cold water or water sitting on leaves can leave brown marks, especially on plants with soft or hairy leaves.",
            inspect: ["Are the spots where water would sit after watering?", "Do you water from above?"],
            actions: ["Water at the base of the plant, not over the leaves.", "Water in the morning so any splashes dry during the day."],
            avoid: "Do not spray the leaves of a plant that already has spots.",
            score: (a) => 1,
            articles: [A("how-to-care-for-calathea", "How to Care for Calathea")],
          },
        ],
      },
      "leaf-curling": {
        label: "Leaf curling",
        intro: "Curling leaves are usually the plant trying to reduce water loss — or reacting to pests, light, or temperature.",
        questions: ["soil", "light", "watering"],
        causes: [
          {
            title: "Underwatering / low humidity",
            reasoning: "When a plant cannot replace the water its leaves lose, it curls them to reduce the exposed surface. Calathea does this dramatically and quickly.",
            inspect: ["Is the soil dry?", "Are the leaves also crispy at the edges?", "Is the air in the room dry?"],
            actions: ["Water thoroughly, then check soil moisture weekly.", "Raise humidity by grouping plants together or using a pebble tray."],
            avoid: "Do not just mist the leaves — it dries in minutes and does not fix the cause.",
            score: (a) => (a.soil === "dry" ? 3 : 0) + (a.watering === "rarely" ? 2 : 0),
            articles: [A("how-to-care-for-calathea", "How to Care for Calathea"), A("how-do-you-care-for-ferns", "How Do You Care for Ferns Indoors?")],
          },
          {
            title: "Too much direct sun or heat",
            reasoning: "Strong sun or hot air makes leaves curl inward to protect themselves from losing water.",
            inspect: ["Is the plant in a hot, sunny window?", "Does the curling ease in the evening?"],
            actions: ["Move the plant to bright, indirect light.", "Keep it away from radiators and hot windowsills."],
            avoid: "Do not water more to compensate — check the soil first.",
            score: (a) => (a.light === "direct" ? 3 : 0),
            articles: [A("snake-plant-light-needs", "Snake Plant Light Needs Explained")],
          },
          {
            title: "Pests",
            reasoning: "Aphids, thrips, and spider mites feed on leaves and can cause curling, distortion, and sticky residue.",
            inspect: ["Look closely under leaves and at new growth for tiny insects, webbing, or sticky residue.", "Are new leaves distorted as they unfurl?"],
            actions: ["Isolate the plant from your other plants.", "Wipe leaves with a damp cloth and rinse the plant with a gentle shower.", "Repeat the check weekly for a few weeks."],
            avoid: "Do not reach for a chemical spray as a first step — start with wiping and isolating.",
            score: (a) => 1,
            articles: [A("how-do-you-take-care-of-plants", "How Do You Take Care of Plants? Beginner Guide")],
          },
        ],
      },
      "falling-leaves": {
        label: "Falling leaves",
        intro: "Some leaf drop is normal, but sudden or heavy drop usually means the plant is stressed by a change.",
        questions: ["leaves", "light", "soil"],
        causes: [
          {
            title: "Shock from a move or change",
            reasoning: "Ficus trees are famous for dropping leaves after a move, a change in light, or a draught. The plant is adjusting, not necessarily dying.",
            inspect: ["Did the plant recently move, or did the seasons change?", "Are the dropped leaves green and healthy-looking?"],
            actions: ["Put the plant in one bright spot and leave it there.", "Keep watering consistent and wait a few weeks."],
            avoid: "Do not keep moving it to 'find a better spot' — each move restarts the shock.",
            score: (a) => (a.leaves === "all" ? 2 : 0),
            articles: [A("how-to-care-for-a-ficus-tree", "How to Care for a Ficus Tree")],
          },
          {
            title: "Overwatering",
            reasoning: "Leaves that yellow and drop, especially lower ones, in wet soil point to roots that are struggling.",
            inspect: ["Is the soil wet days after watering?", "Are the falling leaves yellow or soft?"],
            actions: ["Let the soil dry out between waterings.", "Check that the pot drains and empty the saucer after watering."],
            avoid: "Do not fertilise a dropping plant — it adds stress.",
            score: (a) => (a.soil === "wet" ? 3 : 0),
            articles: [A("how-to-water-snake-plants", "How to Water Snake Plants")],
          },
          {
            title: "Not enough light",
            reasoning: "A plant that cannot make enough food sheds leaves it cannot support, starting with the lowest, shadiest ones.",
            inspect: ["Is the plant far from a window?", "Is the drop mostly lower leaves?"],
            actions: ["Move it closer to a bright window.", "Rotate it regularly."],
            avoid: "Do not move it into harsh direct sun all at once.",
            score: (a) => (a.light === "low" ? 3 : 0) + (a.leaves === "old" ? 1 : 0),
            articles: [A("plants-that-grow-in-the-dark", "Plants That Grow in the Dark (Low Light)")],
          },
        ],
      },
      "slow-growth": {
        label: "Slow growth",
        intro: "Slow growth is often seasonal or light-related — but it can also mean the plant is rootbound or hungry.",
        questions: ["light", "watering", "soil"],
        causes: [
          {
            title: "Not enough light",
            reasoning: "Light is the fuel for growth. A plant in a dim spot grows slowly, with small, pale new leaves — even if everything else is right.",
            inspect: ["Is the plant far from a window?", "Are new leaves smaller than older ones?"],
            actions: ["Move it to the brightest suitable spot for its species.", "Clean dusty leaves — dust blocks light."],
            avoid: "Do not feed a plant that is short of light — fertiliser cannot replace light.",
            score: (a) => (a.light === "low" ? 3 : 0),
            articles: [A("snake-plant-light-needs", "Snake Plant Light Needs Explained"), A("plants-that-grow-in-the-dark", "Plants That Grow in the Dark (Low Light)")],
          },
          {
            title: "Winter dormancy",
            reasoning: "Most houseplants grow little or not at all in autumn and winter. Slow growth in the dark months is usually normal, not a problem.",
