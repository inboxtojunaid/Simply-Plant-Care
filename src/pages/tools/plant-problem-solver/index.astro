          },
          {
            title: "Needs feeding (growing season only)",
            reasoning: "A plant that has been in the same soil for a year or more may have used up the available nutrients.",
            inspect: ["When was the soil last refreshed?", "Is the plant pale overall with slow growth in spring or summer?"],
            actions: ["Feed at half the label strength during the growing season, every 4–6 weeks.", "Refresh the top layer of soil if you do not want to repot."],
