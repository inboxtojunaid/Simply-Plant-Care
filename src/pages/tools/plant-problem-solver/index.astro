          {
            title: "Start with the basics: water, light, pot",
            reasoning: "Most plant problems trace back to one of three things — watering, light, or drainage. Checking these first rules out the majority of causes.",
            inspect: ["Check soil moisture two inches down.", "Check the pot has drainage holes and the saucer is empty.", "Check how much light the plant actually gets."],
            actions: ["Fix watering first: water only when the soil needs it.", "Move the plant to suitable light for its species.", "Remove dead or badly damaged leaves."],
            avoid: "Do not change everything at once — change one thing, then wait a week or two to see the effect.",
            score: (a) => 2,
            articles: [A("how-do-you-take-care-of-plants", "How Do You Take Care of Plants? Beginner Guide"), A("indoor-plants-for-beginners", "Indoor Plants for Beginners: 10 Easy Picks")],
          },
          {
            title: "Pests",
            reasoning: "Tiny insects, webbing, sticky residue, or distorted new growth can all point to pests — check the undersides of leaves closely.",
            inspect: ["Look under leaves and at new growth with a magnifier or phone camera.", "Check for fine webbing, sticky patches, or tiny moving dots."],
            actions: ["Isolate the plant from your other plants.", "Wipe the leaves with a damp cloth and rinse the plant gently.", "Check again weekly for a few weeks."],
            avoid: "Do not spray chemicals as a first step — start with wiping and isolating.",
            score: (a) => 1,
            articles: [A("how-do-you-take-care-of-plants", "How Do You Take Care of Plants? Beginner Guide")],
          },
          {
            title: "Seasonal change",
            reasoning: "Many plants slow down, drop a leaf or two, or look tired in autumn and winter. If the plant is otherwise healthy, it may just be the season.",
            inspect: ["Is it autumn or winter?", "Is new growth still appearing, even slowly?"],
            actions: ["Water less and stop feeding until spring.", "Be patient — growth usually returns with longer days."],
            avoid: "Do not repot or feed a dormant plant.",
            score: (a) => 1,
            articles: [A("how-do-you-take-care-of-plants", "How Do You Take Care of Plants? Beginner Guide")],
          },
        ],
      },
    };

    const SYMPTOM_ORDER = [
      "yellow-leaves", "brown-tips", "drooping", "brown-spots", "leaf-curling",
      "falling-leaves", "slow-growth", "soft-stems", "mold-soil", "other",
    ];

    let currentSymptom = "";
    let answers: Answers = {};

    const stepLabel = document.getElementById("solver-step-label");
    const progressFill = document.getElementById("solver-progress-fill");
    const progressBar = document.getElementById("solver-progress");

    function showStep(n: number) {
      document.querySelectorAll(".tool-step").forEach((el, i) => {
        el.classList.toggle("active", i === n - 1);
      });
      const pct = n === 1 ? 0 : n === 2 ? 50 : 100;
      if (progressFill) progressFill.style.width = `${pct}%`;
      progressBar?.setAttribute("aria-valuenow", String(pct));
      if (stepLabel) {
        stepLabel.textContent =
          n === 1 ? "Step 1 of 3 — Choose a symptom" :
          n === 2 ? "Step 2 of 3 — Answer a few questions" :
          "Step 3 of 3 — Possible causes";
      }
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    // Step 1: build symptom buttons
    const grid = document.getElementById("symptom-grid");
    SYMPTOM_ORDER.forEach((key) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "symptom-btn";
      btn.textContent = SOLVER[key].label;
      btn.setAttribute("aria-pressed", "false");
      btn.addEventListener("click", () => {
        grid?.querySelectorAll(".symptom-btn").forEach((b) => b.setAttribute("aria-pressed", "false"));
        btn.setAttribute("aria-pressed", "true");
        currentSymptom = key;
        answers = {};
        buildQuestions();
        showStep(2);
      });
      grid?.appendChild(btn);
    });

    function buildQuestions() {
      const symptom = SOLVER[currentSymptom];
      const intro = document.getElementById("step-2-intro");
      if (intro) intro.textContent = symptom.intro;
      const wrap = document.getElementById("questions");
      if (!wrap) return;
      wrap.innerHTML = "";
      symptom.questions.forEach((qKey) => {
        const q = QUESTIONS[qKey];
        const fieldset = document.createElement("fieldset");
        fieldset.style.border = "0";
        fieldset.style.padding = "0";
        fieldset.style.margin = "0 0 1.25rem";
        const legend = document.createElement("legend");
        legend.textContent = q.label;
        legend.style.fontWeight = "600";
        legend.style.marginBottom = "0.5rem";
        fieldset.appendChild(legend);
        const list = document.createElement("div");
        list.className = "choice-list";
        q.options.forEach((opt) => {
          const label = document.createElement("label");
          const input = document.createElement("input");
          input.type = "radio";
          input.name = `q-${qKey}`;
          input.value = opt.value;
          input.addEventListener("change", () => {
            answers[qKey] = opt.value;
          });
          const span = document.createElement("span");
          span.textContent = opt.label;
          label.appendChild(input);
          label.appendChild(span);
          list.appendChild(label);
        });
        fieldset.appendChild(list);
        wrap.appendChild(fieldset);
      });
    }

    function renderResults() {
      const symptom = SOLVER[currentSymptom];
      const scored = symptom.causes
        .map((c) => ({ cause: c, score: c.score(answers) }))
        .sort((a, b) => b.score - a.score)
        .slice(0, 4);
      const intro = document.getElementById("results-intro");
      if (intro) {
        intro.textContent = `You chose “${symptom.label}”. These are the most likely causes based on your answers — most plausible first. Remember, this is not a diagnosis.`;
      }
      const wrap = document.getElementById("results");
      if (!wrap) return;
      wrap.innerHTML = "";
      scored.forEach(({ cause }, i) => {
        const card = document.createElement("article");
        card.className = "result-card";
        const h3 = document.createElement("h3");
        h3.textContent = `${i + 1}. ${cause.title}`;
        card.appendChild(h3);
        const why = document.createElement("p");
        why.textContent = cause.reasoning;
        card.appendChild(why);

        const inspectH = document.createElement("h4");
        inspectH.textContent = "What to inspect";
        card.appendChild(inspectH);
        const inspectList = document.createElement("ul");
        cause.inspect.forEach((t) => {
          const li = document.createElement("li");
          li.textContent = t;
          inspectList.appendChild(li);
        });
        card.appendChild(inspectList);

        const actionH = document.createElement("h4");
        actionH.textContent = "What to do";
        card.appendChild(actionH);
        const actionList = document.createElement("ul");
        cause.actions.forEach((t) => {
          const li = document.createElement("li");
          li.textContent = t;
          actionList.appendChild(li);
        });
        card.appendChild(actionList);

        const avoidP = document.createElement("p");
        const avoidStrong = document.createElement("strong");
        avoidStrong.textContent = "Avoid: ";
        avoidP.appendChild(avoidStrong);
        avoidP.appendChild(document.createTextNode(cause.avoid));
        card.appendChild(avoidP);

        if (cause.articles.length > 0) {
          const relH = document.createElement("h4");
          relH.textContent = "Related guides";
          card.appendChild(relH);
          const relList = document.createElement("ul");
          cause.articles.forEach((art) => {
            const li = document.createElement("li");
            const a = document.createElement("a");
            a.href = `/guides/${art.slug}/`;
            a.textContent = art.title;
            li.appendChild(a);
            relList.appendChild(li);
          });
          card.appendChild(relList);
        }
        wrap.appendChild(card);
      });
    }

    document.getElementById("to-results")?.addEventListener("click", () => {
      renderResults();
      showStep(3);
    });
    document.getElementById("back-to-1")?.addEventListener("click", () => showStep(1));
    document.getElementById("back-to-2")?.addEventListener("click", () => showStep(2));
    document.getElementById("start-over")?.addEventListener("click", () => {
      currentSymptom = "";
      answers = {};
      grid?.querySelectorAll(".symptom-btn").forEach((b) => b.setAttribute("aria-pressed", "false"));
      showStep(1);
    });
  </script>
</BaseLayout>
