---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Search Guides"
  description="Search Simply Plant Care guides by plant, problem, or topic."
  canonicalPath="/search/"
>
  <h1>Search guides</h1>
  <form class="search-box" id="search-form" role="search">
    <label for="search-input" style="position:absolute;left:-9999px;">Search guides</label>
    <input
      type="search"
      id="search-input"
      name="q"
      placeholder="Try “snake plant”, “watering”, or “brown tips”"
      autocomplete="off"
    />
    <button class="btn" type="submit">Search</button>
  </form>
  <p class="result-count" id="result-count" aria-live="polite"></p>
  <ul class="search-results" id="results"></ul>
  <p id="empty-state" hidden>
    No guides matched that search. Try a plant name (for example “pothos”),
    a topic (for example “watering”), or a problem (for example “yellow leaves”).
  </p>

  <script>
    const params = new URLSearchParams(window.location.search);
    const input = document.getElementById("search-input") as HTMLInputElement | null;
    const resultsEl = document.getElementById("results");
    const countEl = document.getElementById("result-count");
    const emptyEl = document.getElementById("empty-state");
    const initialQ = params.get("q") || "";
    if (input) input.value = initialQ;

    type Guide = { slug: string; title: string; description: string; keyword: string; category: string };

    let index: Guide[] = [];
    fetch("/search-index.json")
      .then((r) => r.json())
      .then((data: Guide[]) => {
        index = data;
        runSearch(initialQ);
      })
      .catch(() => {
        if (countEl) countEl.textContent = "Search is unavailable right now. Please try again later.";
      });

    function runSearch(q: string) {
      if (!resultsEl || !countEl || !emptyEl) return;
      const query = q.trim().toLowerCase();
      resultsEl.innerHTML = "";
      if (!query) {
        countEl.textContent = "";
        emptyEl.hidden = true;
        return;
      }
      const words = query.split(/\s+/);
      const matches = index.filter((g) => {
        const hay = `${g.title} ${g.description} ${g.keyword} ${g.category}`.toLowerCase();
        return words.every((w) => hay.includes(w));
      });
      countEl.textContent =
        matches.length === 1 ? "1 guide found" : `${matches.length} guides found`;
      emptyEl.hidden = matches.length > 0;
      for (const g of matches) {
        const li = document.createElement("li");
        const h3 = document.createElement("h3");
        const a = document.createElement("a");
        a.href = `/guides/${g.slug}/`;
        a.textContent = g.title;
        h3.appendChild(a);
        const p = document.createElement("p");
        p.textContent = g.description;
        li.appendChild(h3);
        li.appendChild(p);
        resultsEl.appendChild(li);
      }
    }

    document.getElementById("search-form")?.addEventListener("submit", (e) => {
      e.preventDefault();
      runSearch(input?.value || "");
      const url = new URL(window.location.href);
      url.searchParams.set("q", input?.value || "");
      window.history.replaceState(null, "", url);
    });
    input?.addEventListener("input", () => runSearch(input.value));
  </script>
</BaseLayout>
