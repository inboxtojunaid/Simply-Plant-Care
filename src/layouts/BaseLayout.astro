---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = "/",
  ogImage = "/images/hero.jpg",
  jsonLd,
  noindex = false,
} = Astro.props;

const canonical = `https://simplyplantcare.com${canonicalPath}`;
const pageTitle = title === "Simply Plant Care" ? title : `${title} | Simply Plant Care`;
const navLinks = [
  { href: "/guides/", label: "Guides" },
  { href: "/guides/beginner-plant-care/", label: "Beginner" },
  { href: "/guides/plant-problems-solutions/", label: "Problems" },
  { href: "/guides/indoor-plant-watering/", label: "Watering" },
  { href: "/guides/indoor-plant-lighting/", label: "Lighting" },
  { href: "/guides/soil-pots-drainage/", label: "Soil & Pots" },
  { href: "/tools/plant-problem-solver/", label: "Tools" },
];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="RYTYU3BcZF4RdulK6_7bU28vMwjUASFPx1KkBnH9xgE" />
    <meta name="p:domain_verify" content="690eeef0746447281ee12b58d16df8d2" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Simply Plant Care" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`https://simplyplantcare.com${ogImage}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://simplyplantcare.com${ogImage}`} />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Simply Plant Care — home">
          <img src="/images/leaf-mark.svg" alt="Simply Plant Care leaf logo" width="34" height="34" />
          <span>Simply Plant Care</span>
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="main-nav"
          id="nav-toggle"
        >
          Menu
        </button>
        <nav class="main-nav" id="main-nav" aria-label="Main navigation">
          <ul>
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={currentPath === link.href ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="header-cta" href="/tools/plant-problem-solver/">Fix my plant</a>
      </div>
    </header>

    <main id="main-content">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-grid">
          <div class="footer-brand">
            <h3>Simply Plant Care</h3>
            <p>
              Plain, practical indoor plant care guides — written in clear
              language, based on general horticultural knowledge, for people
              who just want their plants to live.
            </p>
            <p>
              Written by
              <a href="/author/zeeshan-farooq/">Zeeshan Farooq, Plants Researcher</a>.
            </p>
            <p>
              <a
                class="social-link"
                href="https://www.pinterest.com/simplyplantcare/"
                target="_blank"
                rel="me noopener"
              >
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="#E60023"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12.017 24c6.627 0 11.986-5.365 11.986-12.013C24.003 5.367 18.644.001 12.017.001z"/></svg>
                Pinterest
              </a>
            </p>
          </div>
          <nav aria-label="Footer guides">
            <h3>Guides</h3>
            <ul>
              <li><a href="/guides/">All guides</a></li>
              <li><a href="/guides/beginner-plant-care/">Beginner plant care</a></li>
              <li><a href="/guides/plant-problems-solutions/">Plant problems</a></li>
              <li><a href="/guides/indoor-plant-watering/">Watering</a></li>
              <li><a href="/guides/indoor-plant-lighting/">Lighting</a></li>
              <li><a href="/guides/soil-pots-drainage/">Soil &amp; pots</a></li>
            </ul>
          </nav>
          <nav aria-label="Footer tools">
            <h3>Tools</h3>
            <ul>
              <li><a href="/tools/plant-problem-solver/">Plant Problem Solver</a></li>
              <li><a href="/tools/plant-care-checklist/">Plant Care Checklist</a></li>
              <li><a href="/tools/tree-planting-cost-calculator/">Tree Planting Cost Calculator</a></li>
              <li><a href="/search/">Search guides</a></li>
            </ul>
          </nav>
          <nav aria-label="Footer site">
            <h3>Site</h3>
            <ul>
              <li><a href="/about/">About</a></li>
              <li><a href="/author/zeeshan-farooq/">About the author</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy-policy/">Privacy Policy</a></li>
              <li><a href="/terms-and-conditions/">Terms &amp; Conditions</a></li>
              <li><a href="/disclaimer/">Disclaimer</a></li>
              <li><a href="/editorial-policy/">Editorial Policy</a></li>
            </ul>
          </nav>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} Simply Plant Care. All rights reserved.</p>
          <p><button type="button" class="footer-cookie-btn" id="cookie-settings">Cookie settings</button></p>
        </div>
      </div>
    </footer>

    <div class="cookie-notice" id="cookie-notice" role="dialog" aria-label="Cookie consent" hidden>
      <p>
        We only use cookies to remember your choice here. We set no tracking
        or advertising cookies ourselves.
        <a href="/privacy-policy/">Privacy Policy</a>
      </p>
      <div class="cookie-buttons">
        <button type="button" class="btn cookie-btn" id="cookie-accept">Accept</button>
        <button type="button" class="btn btn-secondary cookie-btn" id="cookie-decline">Decline</button>
      </div>
    </div>

    <script>
      const toggle = document.getElementById("nav-toggle");
      const nav = document.getElementById("main-nav");
      if (toggle && nav) {
        toggle.addEventListener("click", () => {
          const open = nav.classList.toggle("open");
          toggle.setAttribute("aria-expanded", String(open));
          toggle.textContent = open ? "Close" : "Menu";
        });
      }

      // Cookie consent: stores only the visitor's Accept/Decline choice
      // in localStorage. No cookie is set by this site itself.
      const COOKIE_KEY = "spc-cookie-choice";
      const notice = document.getElementById("cookie-notice");
      function getCookieChoice() {
        try { return localStorage.getItem(COOKIE_KEY); } catch { return null; }
      }
      function setCookieChoice(value) {
        try { localStorage.setItem(COOKIE_KEY, value); } catch {
          // storage unavailable; the notice just won't persist
        }
      }
      function showCookieNotice() { if (notice) notice.hidden = false; }
      function hideCookieNotice() { if (notice) notice.hidden = true; }
      if (notice && !getCookieChoice()) showCookieNotice();
      const acceptBtn = document.getElementById("cookie-accept");
      const declineBtn = document.getElementById("cookie-decline");
      if (acceptBtn) acceptBtn.addEventListener("click", () => { setCookieChoice("accepted"); hideCookieNotice(); });
      if (declineBtn) declineBtn.addEventListener("click", () => { setCookieChoice("declined"); hideCookieNotice(); });
      const settingsBtn = document.getElementById("cookie-settings");
      if (settingsBtn) settingsBtn.addEventListener("click", () => {
        try { localStorage.removeItem(COOKIE_KEY); } catch {
          // ignore
        }
        showCookieNotice();
      });
    </script>
  </body>
</html>
